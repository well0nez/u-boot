/* HY310 projector -- default environment (plan doku/105 section 1.2).
 * eMMC first, netboot as the fallback; h713_boot=net forces the network path.
 * The saved environment on a device overrides all of this. Hush expands one
 * level only, so bootargs are assembled where they are used. The eMMC path
 * is the shipping path and boots with loglevel=4 and without earlycon; the
 * network path is the bench and keeps earlycon, so a kernel that dies before
 * its console driver still says where. Nothing else differs between them.
 *
 * "run fel" (back to FEL without the reset button) is defined for every H713
 * build in include/configs/sunxi-common.h, not here: this file is loaded by
 * three builds only, and the others need it most.
 *
 * h713_project is what this board declares itself to be: it picks the vendor
 * ProjectID_0x*.TSE group and, with it, the panel. 0x30 is what the HY310's own
 * panel_config.ini says ("ProjectID = 48" -- decimal there, hex here). The
 * installer writes it at install time from the device's own file, so a board
 * that is not an HY310 arrives with its own value; unset, "h713_disp init"
 * reads panel_config.ini off Reserve0 itself. h713_mips_dev and
 * h713_mips_path say where the display artifacts live. These defaults describe
 * the layout this environment boots from (doku/109): the artifacts sit in
 * "mips" on the hy310-boot partition, addressed by name so that renumbering
 * cannot break it. Without h713_mips_dev, h713_mips.c looks the partition up
 * by name itself -- bootloader_a/_b per the slot in misc on a stock device,
 * hy310-boot on ours -- so the variable is an override, not a requirement.
 * See doku/108. The "logo" in bootcmd is optional: without bootlogo.bmp in
 * that partition's root (/boot/bootlogo.bmp on our layout) init only warns and
 * the panel stays black until Linux, because the init path fills the OSD
 * buffer black. The installer puts the file there. */
h713_boot=emmc
h713_gate=1
h713_project=0x30
h713_mips_dev=1#hy310-boot
h713_mips_path=mips
bootfile=h713-kernel-netboot.fit
serverip=192.168.8.123
nfsroot=/srv/h713-rootfs
bootargs_base=console=ttyS0,115200 rootwait clk_ignore_unused pd_ignore_unused cma=128M net.ifnames=0
boot_emmc=
	if ext4load mmc 1:5 0x60000000 h713-kernel.fit; then
		setenv bootargs "${bootargs_base} loglevel=4 root=PARTLABEL=hy310-rootfs rw";
		bootm 0x60000000;
	fi
boot_net=
	dhcp;
	setenv bootargs "${bootargs_base} earlycon root=/dev/nfs rw nfsroot=${serverip}:${nfsroot},vers=3,tcp ip=dhcp";
	tftpboot 0x60000000 ${serverip}:${bootfile};
	bootm 0x60000000
bootcmd=h713_disp init ${h713_project} logo; run boot_${h713_boot}; run boot_net
