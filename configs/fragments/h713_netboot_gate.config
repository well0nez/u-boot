# Role: netboot_gate -- netboot with the power gate compiled in.
#
# h713_netboot.config plus CONFIG_H713_POWER_GATE=y, and kept as a full copy
# rather than a delta on it: uboot-build.sh applies exactly one role, and a
# fragment that only makes sense stacked on another is a trap for whoever
# reads it next. It exists because the gate had to be proven before it was
# allowed into the shipping build, and a netboot round trip is a much cheaper
# way to fail than an eMMC write. h713_netboot.config explains the four
# switch-off lines that follow USB_GADGET.
CONFIG_H713_POWER_GATE=y
# CONFIG_USB_MUSB_SUNXI is not set
# CONFIG_USB_GADGET is not set
# CONFIG_CMD_BIND is not set
# CONFIG_ANDROID_BOOT_IMAGE is not set
# CONFIG_USB_MUSB_PIO_ONLY is not set
# CONFIG_CIRCBUF is not set
CONFIG_NET=y
CONFIG_CMD_NET=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_NFS=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_USB_HOST_ETHER=y
CONFIG_USB_ETHER_RTL8152=y
CONFIG_ENV_SOURCE_FILE="hy310"
CONFIG_BOOTCOMMAND="h713_disp init ${h713_project}; run boot_${h713_boot}; run boot_net"
