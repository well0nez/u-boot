# Role: felmmc -- not a bootable image.
#
# An SPL that writes the original vendor boot0 back to the eMMC over FEL, for
# the one case where the first boot stage has to be restored. That is why this
# is the only role with SPL_MMC_WRITE and why its SPL may be 80 KiB; U-Boot
# proper is never reached, so it carries no boot command at all.
#
# The four lines that put values back are not decoration: they are Kconfig
# defaults the base overrides, and this role predates our layout. It writes to
# a device that still has the vendor's boot chain on it, so it must not take
# our U-Boot sector, our environment slot or our chainload with it.
# CONFIG_H713_POWER_GATE is not set
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x40
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_DATA_PART_OFFSET=0x10
# CONFIG_H713_VENDOR_CHAINLOAD is not set
CONFIG_H713_SPL_FORCE_MMC=y
CONFIG_SPL_MMC_WRITE=y
CONFIG_SPL_MAX_SIZE=0x14000
