# Role: installer -- exposes the eMMC as a USB drive, from FEL.
#
# Started over FEL by hy310-install, so it must not read or write an
# environment on the device it is about to write: ENV_IS_NOWHERE, which also
# drops ENV_OFFSET and ENV_MMC_DEVICE_INDEX from the base. And it must not
# boot anything -- the boot command ends in ums and stays there, with no delay
# in front of it. Gate off: the board is on a bench with a cable in it.
#
# The message is what a person with a UART lead sees while h713-install
# writes; it names the role, not a board, because the fragment is one for
# every board base.
CONFIG_BOOTDELAY=0
# CONFIG_H713_POWER_GATE is not set
# CONFIG_ENV_IS_IN_MMC is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_BOOTCOMMAND="echo H713 installer: exposing the eMMC as a USB drive; ums 0 mmc 1"
# The drive exposure needs "usb start" before ums: without it the gadget never
# enumerates on the host ("Cannot enable ... unable to enumerate USB device",
# three failed installs on 15.09.2026 with a preboot that had dropped it; the
# same image installed at once with the previous installer U-Boot). The product
# boot does not run it (Marco: only the installer), so it lives here, not in the
# base defconfig. The reboot-mode magics are pointless in a FEL-loaded U-Boot.
CONFIG_PREBOOT="usb start"
